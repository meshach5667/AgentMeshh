# AgentMesh AI inference adapter. Copy to ~/.config/agentmesh/ai-adapter.env and chmod 600.
AGENTMESH_CONTROL_PLANE_URL=https://agentmesh-riuz.onrender.com
AI_INFERENCE_TOKEN=
AI_INFERENCE_NODE_ID=hp15
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
AI_REQUEST_TIMEOUT=180
AI_MAX_CONCURRENT_REQUESTS=1
AI_NUM_CTX=4096
AI_MAX_TOKENS=512
AI_MIN_AVAILABLE_MEMORY_MB=1024
AI_MAX_LOAD_PER_CPU=1.5
